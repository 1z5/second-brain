# ============ LLM（负责生成回答）============
# DeepSeek / 通义 / 智谱 / Kimi 等任何 OpenAI 兼容接口都行，改这两行即可
LLM_BASE_URL=https://api.stepfun.com/step_plan/v1
LLM_API_KEY=在这里填你的key
LLM_MODEL=step-5-preview
# step-5 是推理模型：问答场景 low 档就够，快且省 token
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=2000

# ============ Embedding（负责文本向量化）============
# 默认用本地 Ollama 跑，笔记内容不出本机；维度 768
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=nomic-embed-text

# ============ 检索参数 ============
CHUNK_SIZE=400       # 每个分块的目标字符数
CHUNK_OVERLAP=60     # 相邻分块的重叠字符数
TOP_K=4              # 每次提问检索几个片段

# ============ 想切换全本地模型？改成这样：============
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
# LLM_REASONING_EFFORT=off
